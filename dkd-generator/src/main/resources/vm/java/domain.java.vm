## ============================================
## Java Domain实体类生成模板
## 用于生成业务实体类，支持CRUD和树形结构
## 包含Lombok注解、Excel导出、主子表等功能
## ============================================
package ${packageName}.domain;

    #foreach ($import in $importList)
    import ${import};
    #end

import org.apache.commons.lang3.builder.ToStringBuilder;
import org.apache.commons.lang3.builder.ToStringStyle;
import com.dkd.common.annotation.Excel;
    #if($table.crud || $table.sub)
    import com.dkd.common.core.domain.BaseEntity;
    #elseif($table.tree)
    import com.dkd.common.core.domain.TreeEntity;
    #end
    ## 导入lombok注解
    ## Lombok注解：@Data自动生成getter/setter/toString等方法
    ## @NoArgsConstructor生成无参构造器
    ## @AllArgsConstructor生成全参构造器
    ## @Builder生成建造者模式支持
import lombok.AllArgsConstructor;
import lombok.Builder;
import lombok.Data;
import lombok.NoArgsConstructor;

/**
 * ${functionName}对象 ${tableName}
 *
 * @author ${author}
 * @date ${datetime}
 */
    #if($table.crud || $table.sub)
        #set($Entity="BaseEntity")
    #elseif($table.tree)
        #set($Entity="TreeEntity")
    #end

    ## 根据表类型动态设置父类（CRUD继承BaseEntity，树形结构继承TreeEntity）
    ## 使用Lombok注解简化实体类代码
        @Data
        @NoArgsConstructor
        @AllArgsConstructor
        @Builder
        public class ${ClassName} extends ${Entity}
        {
        private static final long serialVersionUID = 1L;

    ## 遍历所有列，生成非继承字段的属性定义
    #foreach ($column in $columns)
        #if(!$table.isSuperColumn($column.javaField))
                /** $column.columnComment */
            ## 判断字段是否在列表中显示，如果是则添加Excel导出注解
            #if($column.list)
                #set($parentheseIndex=$column.columnComment.indexOf("（"))
                #if($parentheseIndex != -1)
                    ## 提取括号前的注释内容作为Excel列名
                    #set($comment=$column.columnComment.substring(0, $parentheseIndex))
                #else
                    ## 使用完整注释作为Excel列名
                    #set($comment=$column.columnComment)
                #end
                ## 根据字段类型添加不同的Excel导出注解
                #if($parentheseIndex != -1)
                @Excel(name = "${comment}", readConverterExp = "$column.readConverterExp()")
                #elseif($column.javaType == 'Date')
                    ## 日期类型字段添加JSON格式化和Excel日期格式
                @JsonFormat(pattern = "yyyy-MM-dd")
                @Excel(name = "${comment}", width = 30, dateFormat = "yyyy-MM-dd")
                #else
                @Excel(name = "${comment}")
                #end
            #end
        private $column.javaType $column.javaField;

        #end
    #end
    #if($table.sub)
        ## 子表信息列表，用于主子表场景
            /** $table.subTable.functionName信息 */
            private List<${subClassName}> ${subclassName}List;

    #end
        }
